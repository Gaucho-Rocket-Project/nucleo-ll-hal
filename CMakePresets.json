{
  "version": 3,
  "configurePresets": [
    {
      "name": "l476-debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/l476-debug",
      "toolchainFile": "${sourceDir}/cmake/arm-gcc.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BOARD": "NUCLEO_L476RG",
        "FIRMWARE_TEST": ""
      }
    },
    {
      "name": "f446-debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/f446-debug",
      "toolchainFile": "${sourceDir}/cmake/arm-gcc.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BOARD": "NUCLEO_F446RE"
      }
    },
    {
      "name": "l476-hardware-test",
      "inherits": "l476-debug",
      "binaryDir": "${sourceDir}/build/l476-hardware-test",
      "cacheVariables": {
        "FIRMWARE_TEST": "uart"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "l476-debug",
      "configurePreset": "l476-debug"
    },
    {
      "name": "f446-debug",
      "configurePreset": "f446-debug"
    },
    {
      "name": "l476-hardware-test",
      "configurePreset": "l476-hardware-test"
    }
  ]
}
