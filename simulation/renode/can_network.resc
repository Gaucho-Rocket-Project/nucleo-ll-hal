# STM32F446RE CAN SocketCAN Test

emulation CreateCANHub "canHub"

mach create "f446"

# Load the hardware platform
machine LoadPlatformDescription $ORIGIN/stm32f446.repl

# Load the compiled F446 firmware
sysbus LoadELF @/home/vmuser/projects/nucleo-ll-hal/build/f446-debug/nucleo_hal.elf

# Connect CAN1 to the virtual bus
connector Connect sysbus.can1 canHub

# Connect the virtual bus to Linux SocketCAN
machine CreateSocketCANBridge "socketcan" "vcan0"
connector Connect socketcan canHub

# Enable debugging
machine StartGdbServer 3333